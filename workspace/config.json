{
  "llm": {
    "base_url": "http://127.0.0.1:8080",
    "model": "auto",
    "openai_compatible": true,
    "temperature": 0.2,
    "max_tokens": 1500,
    "context_window_tokens": 32768,
    "connect_timeout_seconds": 5,
    "read_timeout_seconds": 120,
    "model_discovery_timeout_seconds": 3,
    "model_discovery_negative_ttl_seconds": 60,
    "retry_max_attempts": 3,
    "retry_base_delay_seconds": 0.5,
    "retry_max_delay_seconds": 2.0,
    "retry_jitter_seconds": 0.2,
    "max_concurrent_requests": 1,
    "cooldown_seconds": 2.0,
    "retry_read_timeouts": false,
    "stream_responses": true,
    "agent_max_tokens": 3600
  },
  "context_engine": {
    "safety_margin_tokens": 500,
    "chars_per_token_fallback": 3,
    "cached_prompt_weight": 0.2
  },
  "web": {
    "api_token": null,
    "rate_limit": {
      "requests": 180,
      "auth_failures": 10,
      "window_seconds": 60
    }
  },
  "codar": {
    "ativado": true,
    "testes": {
      "ativado": true,
      "comando_python": "python -m pytest -q",
      "comando_node": "npm test --silent",
      "timeout_segundos": 60,
      "sandbox": {
        "backend": "auto",
        "bloquear_rede": true,
        "comandos_permitidos": [
          [
            "pytest"
          ],
          [
            "python",
            "-m",
            "pytest"
          ],
          [
            "python3",
            "-m",
            "pytest"
          ],
          [
            "npm",
            "test"
          ]
        ],
        "cpu_segundos": 60,
        "memoria_mb": 1024,
        "max_processos": 128,
        "max_arquivos_abertos": 256,
        "max_saida_kb": 1024,
        "max_arquivo_mb": 64,
        "copiar_projeto": true,
        "max_arquivos_projeto": 100000,
        "max_tamanho_projeto_mb": 2048,
        "cpus": 1.0,
        "allow_trusted_local": true
      }
    }
  },
  "confirmacoes": {
    "expiracao_segundos": 3600
  },
  "agent": {
    "max_tree_entries": 200,
    "max_tree_depth": 6,
    "max_file_read_lines": 400,
    "task_deadline_seconds": 1800,
    "max_llm_calls": 32,
    "max_secret_scan_bytes": 65536,
    "max_prompt_tokens": 90000,
    "max_completion_tokens": 8000,
    "max_total_tokens": 98000,
    "max_llm_turns": 24,
    "max_tool_calls": 64,
    "max_patch_dry_run_failures": 2,
    "context_view": {
      "max_source_preview_chars": 3500,
      "max_symbol_preview_chars": 2600,
      "max_search_source_chars": 600
    },
    "max_project_scan_entries": 20000,
    "max_project_scan_depth": 32,
    "max_project_file_bytes": 4194304,
    "max_inspect_relation_edges": 60,
    "max_git_diff_chars": 6000,
    "max_search_matches": 40,
    "max_search_ranges": 12,
    "claims": {
      "mode": "self_check",
      "verifier": {
        "max_tokens": 900,
        "temperature": 0.0
      },
      "evidence": {
        "max_chars_per_item": 2200
      }
    },
    "max_search_range_lines": 16,
    "sandbox": {
      "backend": "auto",
      "bloquear_rede": false,
      "timeout_segundos": 300,
      "cpu_segundos": 300,
      "memoria_mb": 2048,
      "max_processos": 256,
      "max_arquivos_abertos": 512,
      "max_saida_kb": 2048,
      "max_arquivo_mb": 512,
      "copiar_projeto": true,
      "max_arquivos_projeto": 100000,
      "max_tamanho_projeto_mb": 4096,
      "cpus": 2.0,
      "allow_trusted_local": false,
      "imagem_docker": "python:3.12-slim"
    }
  },
  "worker": {
    "heartbeat_interval_seconds": 5,
    "queue_error_backoff_seconds": 1,
    "max_invalid_jobs_per_reservation": 100,
    "max_parallel_jobs": 1,
    "isolate_jobs": true,
    "stale_worker_seconds": 30,
    "head_of_line_blocked_seconds": 60,
    "multiprocessing_context": "spawn"
  },
  "telemetry": {
    "enabled": true,
    "window_seconds": 3600
  },
  "app_version": "2.7.4",
  "config_schema_version": "5.7.5",
  "revision": "rev5.7.5-canonical-boundary-hardening"
}
