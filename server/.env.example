# Eyle Rev3.7.5.1 — DeepSeek Adapter boundary
# Eyle talks to the local Adapter; the Adapter connects to the configured upstream.

PROVIDER_PROFILE=deepseek_v4
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=

# One fixed configured model. No discovery or auto-selection.
MODEL=deepseek-v4-flash

HOST=127.0.0.1
PORT=8080
REQUEST_TIMEOUT_SECONDS=1800
MAX_REQUEST_BYTES=10485760
LOG_LEVEL=INFO

# Optional: protect the Adapter against non-local clients.
PROXY_API_KEY=
PROXY_ALLOW_LOOPBACK_NO_AUTH=true
