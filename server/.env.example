# Obrigatório: chave da API do Alibaba Cloud Model Studio / DashScope ou outras APIs compativeis
DASHSCOPE_API_KEY=sk-coloque-sua-chave-aqui

# Endpoint internacional compatível com OpenAI
UPSTREAM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Modelo usado quando o cliente não informar um modelo
DEFAULT_MODEL=qwen3.8-max

# Quando preenchido, substitui qualquer modelo enviado pela Eyle
# MODEL_OVERRIDE=qwen3.8-max

# Pensamento do Qwen
# Conversas e respostas textuais comuns
DEFAULT_ENABLE_THINKING=true

# Decisões JSON internas do agente: false é mais rápido e confiável
STRUCTURED_ENABLE_THINKING=false

# true ignora as opções acima e força pensamento em tudo
FORCE_ENABLE_THINKING=false

# Servidor local
HOST=127.0.0.1
PORT=8080
REQUEST_TIMEOUT_SECONDS=600
MAX_REQUEST_BYTES=10485760
LOG_LEVEL=INFO

# Opcional. Ao definir, a Eyle precisa enviar esta chave como Bearer.
# PROXY_API_KEY=uma-chave-local-bem-grande
