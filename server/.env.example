# Eyle Rev3.6.1 — deterministic DeepSeek V4 Adapter
# Eyle talks only to 127.0.0.1:8080. This Adapter translates mechanically to DeepSeek.

PROVIDER_PROFILE=deepseek_v4
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
# DEEPSEEK_API_KEY is accepted as an alias for UPSTREAM_API_KEY.

# One fixed configured model. No GET /models, no discovery, no auto selection.
MODEL=deepseek-v4-flash

HOST=127.0.0.1
PORT=8080
REQUEST_TIMEOUT_SECONDS=1800
MAX_REQUEST_BYTES=10485760
LOG_LEVEL=INFO

# Optional: protect the Adapter against non-local clients.
PROXY_API_KEY=
PROXY_ALLOW_LOOPBACK_NO_AUTH=true
