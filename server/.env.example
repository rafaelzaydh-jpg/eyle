# Eyle Universal LLM Adapter
# A Eyle aponta para http://127.0.0.1:8080/v1 e continua pedindo JSON Schema normalmente.

HOST=127.0.0.1
PORT=8080
REQUEST_TIMEOUT_SECONDS=600
DEFAULT_MAX_OUTPUT_TOKENS=4096
STRUCTURED_REPAIR_ATTEMPTS=1

# Thinking padrão. Chamadas estruturadas ficam sem thinking por padrão.
DEFAULT_ENABLE_THINKING=true
STRUCTURED_ENABLE_THINKING=false
FORCE_ENABLE_THINKING=false

# ---------------- PRIMARY ----------------
# Exemplo: DeepSeek via API OpenAI-compatible.
LLM_PROTOCOL=openai
UPSTREAM_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_API_KEY=COLOQUE_SUA_CHAVE
DEFAULT_MODEL=deepseek-v4-flash
PROVIDER_PROFILE=deepseek
STRUCTURED_BACKEND=native_json
THINKING_STYLE=deepseek

# Outros STRUCTURED_BACKEND possíveis:
# native_schema = provider realmente aceita JSON Schema
# native_tool   = schema vira uma function/tool forçada
# native_json   = JSON mode + schema no prompt + validação/repair local
# text          = texto + schema no prompt + validação/repair local

# Para OpenAI-compatible desconhecido normalmente basta trocar estas linhas:
# UPSTREAM_BASE_URL=https://api.exemplo.com/v1
# UPSTREAM_API_KEY=...
# DEFAULT_MODEL=modelo
# PROVIDER_PROFILE=generic
# STRUCTURED_BACKEND=native_json
# THINKING_STYLE=none

# ---------------- FALLBACK OPCIONAL ----------------
# O fallback NÃO roteia semanticamente. Só é usado quando a resposta estruturada
# continua violando o contrato após o repair permitido.
# Para desativar, deixe FALLBACK_UPSTREAM_BASE_URL e FALLBACK_DEFAULT_MODEL vazios.

FALLBACK_UPSTREAM_BASE_URL=
FALLBACK_DEFAULT_MODEL=
# FALLBACK_LLM_PROTOCOL=openai
# FALLBACK_UPSTREAM_API_KEY=COLOQUE_SUA_CHAVE
# FALLBACK_PROVIDER_PROFILE=qwen
# FALLBACK_STRUCTURED_BACKEND=native_schema
# FALLBACK_THINKING_STYLE=qwen
