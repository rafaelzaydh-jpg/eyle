# Eyle Rev3 — universal transport-only Adapter for OpenAI-compatible APIs
# A Eyle fala somente com 127.0.0.1:8080. O Adapter fala com a API remota abaixo.
# NÃO existe backend local obrigatório e não há fallback para 127.0.0.1:8000.

# Exemplo: https://seu-provedor.example/v1
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# "auto" usa GET <UPSTREAM_BASE_URL>/models.
# Para máxima compatibilidade, prefira informar o ID real do modelo.
DEFAULT_MODEL=auto
MODEL_OVERRIDE=

# auto | native_json_schema | json_object | prompt_json
UPSTREAM_STRUCTURED_MODE=auto

# auto | none | implicit | explicit | session
UPSTREAM_CACHE_MODE=auto

# Escape hatch para providers OpenAI-compatible que exigem headers/campos extras.
UPSTREAM_EXTRA_HEADERS_JSON={}
UPSTREAM_EXTRA_BODY_JSON={}
UPSTREAM_CACHE_HEADERS_JSON={}
UPSTREAM_CACHE_BODY_JSON={}

HOST=127.0.0.1
PORT=8080
REQUEST_TIMEOUT_SECONDS=1800
MAX_REQUEST_BYTES=10485760
MODEL_DISCOVERY_TTL_SECONDS=300
MODEL_DISCOVERY_NEGATIVE_TTL_SECONDS=30
LOG_LEVEL=INFO

# Opcional: protege o Adapter contra clientes não-locais.
PROXY_API_KEY=
PROXY_ALLOW_LOOPBACK_NO_AUTH=true
